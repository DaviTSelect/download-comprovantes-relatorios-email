# Microsoft Graph API (MSAL)
# Obter no Azure AD > App registrations > seu app
GRAPH_CLIENT_ID=seu_client_id_aqui
GRAPH_CLIENT_SECRET=seu_client_secret_aqui
GRAPH_TENANT_ID=seu_tenant_id_aqui

# E-mail remetente (caixa que envia os arquivos)
USER_EMAIL=seu_email@suaempresa.com.br

# Conveniar
CONVENIAR_URL=
CONVENIAR_USUARIO=seu_usuario_conveniar
CONVENIAR_SENHA=sua_senha_conveniar

# Chrome portátil (opcional — deixar em branco para usar o Chrome do sistema)
# Usar %USERPROFILE% para funcionar em qualquer máquina Windows
CHROME_BINARY=%USERPROFILE%\Chrome\GoogleChrome\App\Chrome-bin\chrome.exe
CHROMEDRIVER_PATH=%USERPROFILE%\Chrome\chromedriver.exe
